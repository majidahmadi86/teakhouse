# Copy to .env / .env.local and fill values.

# --- Database ---
# Local zero-config (default in this repo):
DATABASE_URL="file:./dev.db"
# Production / Supabase / any Postgres:
# 1. In prisma/schema.prisma set: provider = "postgresql"
# 2. DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require"

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OWNER_PIN=1234
NEXT_PUBLIC_OWNER_PIN=1234

# --- Demo sandbox (Commit 3) ---
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# --- AI concierge (Commit 5) ---
# AI_PROVIDER=anthropic|openai|groq
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# --- Email (Commit 4 stub) ---
# EMAIL_PROVIDER=resend|smtp|stub
# EMAIL_API_KEY=
# EMAIL_FROM=stay@example.com
