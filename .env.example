# Copy to .env / .env.local and fill values.

# --- Database (Supabase Postgres) ---
# Pooled URL for the app (port 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for migrations (port 5432). URL-encode special chars in the password (@ → %40).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
# Local SQLite swap (optional): set provider = "sqlite" in schema.prisma and
# DATABASE_URL="file:./dev.db" (remove directUrl).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OWNER_PIN=1234
NEXT_PUBLIC_OWNER_PIN=1234

# --- Demo sandbox ---
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
# Bearer token for /api/cron/reseed (Vercel cron)
# CRON_SECRET=

# --- AI concierge ---
# AI_PROVIDER=anthropic|openai|groq
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# AI_MODEL=

# --- Email stub ---
# EMAIL_PROVIDER=resend|smtp|stub
# EMAIL_API_KEY=
# EMAIL_FROM=stay@example.com
