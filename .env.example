# Hotelier · environment template
# Copy this file to .env.local (local dev) or set these in Vercel (deploy).
#   cp .env.example .env.local
# Never commit real values · .env / .env*.local are gitignored.

# =====================================================================
# Database (Prisma)
# =====================================================================
# Production: Supabase / any Postgres. Two URLs are required:
#   DATABASE_URL  · pooled, used by the running app  (port 6543, ?pgbouncer=true)
#   DIRECT_URL    · direct,  used by prisma migrate   (port 5432)
# URL-encode special characters in the password (for example  @  ->  %40 ).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# Local SQLite alternative (no Postgres needed):
#   1) in prisma/schema.prisma set  provider = "sqlite"  and remove directUrl
#   2) here set:      DATABASE_URL="file:./dev.db"
#   3) run:           npx prisma db push && npx prisma db seed

# =====================================================================
# Site
# =====================================================================
# Public base URL of this deployment (used for canonical/OG links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Owner dashboard PIN (/owner sign-in). Change both for production.
OWNER_PIN="1234"
NEXT_PUBLIC_OWNER_PIN="1234"

# =====================================================================
# Demo sandbox
# =====================================================================
# true  = self-resetting demo (banner, reset button, hourly cron reseed)
# false = real property (permanent data, no demo UI). Set BOTH for a real hotel.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# Bearer token that guards the Vercel cron endpoint /api/cron/reseed.
# Only needed when DEMO_MODE=true and you schedule the hourly reseed.
# CRON_SECRET=""

# =====================================================================
# AI concierge (optional · provider-agnostic)
# =====================================================================
# Leave unset to run the concierge in a safe stubbed mode.
# AI_PROVIDER="anthropic"          # anthropic | openai | groq
# ANTHROPIC_API_KEY=""             # for AI_PROVIDER=anthropic
# OPENAI_API_KEY=""                # for AI_PROVIDER=openai
# GROQ_API_KEY=""                  # for AI_PROVIDER=groq
# AI_MODEL=""                      # optional model override

# =====================================================================
# Booking confirmation email (optional · stubbed by default)
# =====================================================================
# EMAIL_PROVIDER="stub"            # resend | smtp | stub
# EMAIL_API_KEY=""
# EMAIL_FROM="stay@example.com"
